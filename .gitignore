/target
/.claude/
/TAGS

# State 0.1 wrote into its state dir: managed Lisp microgrid files,
# snapshots and enterprise.lisp. 0.2 refuses to start on a state dir
# that holds them, so these guard against committing leftovers.
# enterprise.lisp is unanchored, as any directory could have been one.
/microgrids/
/snapshots/
enterprise.lisp

# Recordings' CSV files, under the state dir (default: cwd).
/recordings/

# NFS silly-rename strays (an editor holding an fd to a replaced file)
.nfs*

# brainstorming / SDD scratch (ledgers, briefs, mockups)
/.superpowers/
.worktrees/

# A node_modules from before Playwright moved out of the checkout
# (Makefile PLAYWRIGHT_DIR); delete it.
/node_modules

# Bytecode of the example scripts, their tests and the smoke's site.
/examples/**/__pycache__/
/tools/ui-smoke/__pycache__/
