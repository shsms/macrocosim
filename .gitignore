# Managed-microgrid-file state: written by macrocosim itself, at
# --state-dir (default: cwd) or wherever a boot script's directory
# ends up doubling as one (e.g. examples/enterprise.lisp when a demo
# script boots from the checkout). enterprise.lisp is unanchored on
# purpose — any directory a script boots from gets its own.
/microgrids/
/snapshots/
enterprise.lisp

# NFS silly-rename strays (an editor holding an fd to a replaced file)
.nfs*

